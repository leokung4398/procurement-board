rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // 判斷是否為公司已驗證之帳號 (@youbike.com.tw 或母公司 @giantcycling.com)
    function isCompanyUser() {
      return request.auth != null && 
             (request.auth.token.email.matches('.*@youbike[.]com[.]tw$') ||
              request.auth.token.email.matches('.*@giantcycling[.]com$'));
    }

    match /attachments/{bulletinId}/{fileName} {
      // 唯有已登入之公司企業帳號方可讀取與下載附件
      allow read: if isCompanyUser();
      
      // 僅限公司內部已驗證同仁/管理員上傳，且單檔大小嚴格限制在 20MB 以內
      allow write: if isCompanyUser() && request.resource.size < 20 * 1024 * 1024;
    }
    
    // 阻擋其餘未授權的路徑存取
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

