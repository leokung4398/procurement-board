rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 判斷是否為已驗證之公司 Google 帳號 (@youbike.com.tw 或母公司 @giantcycling.com / @giant.com.tw，不區分大小寫)
    function isCompanyUser() {
      return request.auth != null && 
             request.auth.token.email != null &&
             (request.auth.token.email.matches('(?i).*@youbike[.]com([.]tw|[.]cn)?$') ||
              request.auth.token.email.matches('(?i).*@giantcycling[.]com$') ||
              request.auth.token.email.matches('(?i).*@giant[.]com([.]tw|[.]cn)?$') ||
              request.auth.token.email.matches('(?i).*@giant-bicycles[.]com([.]tw)?$'));
    }

    // 1. 佈告欄集合 (Bulletins)
    match /bulletins/{bulletinId} {
      // 僅限公司內部登入同仁與管理員讀取（頁尾聯絡資訊 config_handover 允許初始化讀取）
      allow read: if isCompanyUser() || bulletinId == 'config_handover';
      
      // 寫入權限：限內部員工/管理員操作，嚴格禁止直接物理刪除 (Hard Delete)，統一使用軟刪除
      allow create, update: if isCompanyUser();
      allow delete: if false;

      // 1-1. 機密保險箱子集合 (Private Content)
      match /private/{docId} {
        // 唯有已登入之公司企業帳號方可讀寫
        allow read, write: if isCompanyUser();
      }

      // 1-2. 已讀打卡紀錄子集合 (Read Receipts)
      match /readReceipts/{userId} {
        // 限公司同仁打卡與管理員統計讀取，嚴禁刪除打卡存根
        allow read: if isCompanyUser();
        allow create, update: if isCompanyUser();
        allow delete: if false;
      }
    }

    // 2. 使用者身分集合 (Users)
    match /users/{userId} {
      // 限公司內部帳號登記與檢視
      allow read, create, update: if isCompanyUser();
      allow delete: if false;
    }

    // 3. 系統設定集合 (System Config)
    match /systemConfig/{doc} {
      // 允許公司同仁讀取白名單與通訊錄，限公司同仁更新，禁止刪除設定檔
      allow read, create, update: if isCompanyUser();
      allow delete: if false;
    }

    // 4. 使用需求調查問卷集合 (Surveys)
    match /surveys/{surveyId} {
      // 允許公司同仁提交意見反饋與後台統計讀取，禁止刪除問卷歷程
      allow read, create, update: if isCompanyUser();
      allow delete: if false;
    }
  }
}
