rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // 1. 佈告欄集合 (Bulletins)
    match /bulletins/{bulletinId} {
      // 允許所有使用者讀取佈告欄資訊 (包含 index.html 與 admin.html 初始載入)
      allow read: if true;
      
      // 寫入權限：允許新增與更新（系統刪除採用 status: 'deleted' 軟刪除）
      // 嚴格禁止直接從前台物理刪除 (Hard Delete) 文件，防止資料庫被一鍵清空
      allow create, update: if true;
      allow delete: if false;

      // 1-1. 已讀紀錄子集合 (Read Receipts)
      match /readReceipts/{userId} {
        // 允許讀取與打卡紀錄寫入，禁止外部刪除打卡存根
        allow read: if true;
        allow create, update: if true;
        allow delete: if false;
      }
    }

    // 2. 使用者身分集合 (Users)
    match /users/{userId} {
      // 允許登記與更新個人資訊，禁止整筆刪除
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // 3. 系統設定集合 (System Config)
    match /systemConfig/{doc} {
      // 允許讀取與更新設定，禁止刪除設定檔
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // 4. 使用需求調查問卷集合 (Surveys)
    match /surveys/{surveyId} {
      // 允許同仁提交問卷與後台統計讀取，問卷為重要歷程紀錄，禁止前台刪除
      allow read: if true;
      allow create, update: if true;
      allow delete: if false;
    }
  }
}
